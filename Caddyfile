# Caddy configuration for Desk Agent
# Uses DOMAIN environment variable (passed from docker-compose)
# Defaults to localhost for local development

{$DOMAIN:localhost} {
    # Open Connector console - accessible at /connector/
    handle_path /connector/* {
        reverse_proxy connector:3000
    }
    
    # Open Connector API routes
    handle /v1/* {
        reverse_proxy connector:3000
    }
    handle /api/connections* {
        reverse_proxy connector:3000
    }

    # OAuth callback from Google - must go to connector
    handle /oauth/callback {
        reverse_proxy connector:3000
    }

    # OAuth API routes - must go to connector BEFORE agent /api/*
    handle /api/oauth/* {
        reverse_proxy connector:3000
    }

    # MCP endpoint - goes to connector
    handle /mcp {
        reverse_proxy connector:3000
    }
    handle /mcp/* {
        reverse_proxy connector:3000
    }

    # Agent Web UI and API
    handle /api/* {
        reverse_proxy agent:3001
    }
    handle /auth {
        reverse_proxy agent:3001
    }
    handle /health {
        reverse_proxy agent:3001
    }
    handle {
        reverse_proxy agent:3001
    }

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        X-XSS-Protection "1; mode=block"
        Referrer-Policy strict-origin-when-cross-origin
    }

    # Logging
    log {
        output file /data/access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}

# Alternative: Open Connector on separate subdomain
# Uncomment if you prefer connector.yourdomain.com instead of /connector/
