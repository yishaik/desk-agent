# Desk Agent — public routing.
#
# Two hosts:
#   {$CONSOLE_DOMAIN}  the Open Connector console for extra tools.
#                      Protected by Open Connector's own admin-token login
#                      (CONNECTOR_ADMIN_TOKEN). PAIR_TOKEN is host-only on the
#                      agent domain and is NOT sent here (U-02).
#   {$DOMAIN}          the agent UI/API. Only the OAuth *callback* is proxied
#                      to the connector; every other connector endpoint stays
#                      on the internal Docker network (S-08, S-25).
#
# Security: Do NOT expose /mcp, /v1, /openapi, /files, /runs, /api/oauth/*,
# or /connector/ on the main domain.

{$CONSOLE_DOMAIN:console.localhost} {
    reverse_proxy connector:3000
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    }

    log {
        output file /data/console-access.log {
            roll_size 10mb
            roll_keep 5
        }
        format filter {
            wrap json
            fields {
                request>uri query {
                    delete token
                }
            }
        }
    }
}

{$DOMAIN:localhost} {
    # OAuth redirect target (CONNECTOR_ORIGIN/oauth/callback) — must be public.
    handle /oauth/* {
        reverse_proxy connector:3000
    }

    # Everything else is the agent (wizard, settings, /api/*, /auth, /health).
    # The agent reaches the connector at http://connector:3000 on the Docker
    # network. Do not proxy /api/oauth/* here — those are admin-scope routes
    # and are open on the connector if CONNECTOR_ADMIN_TOKEN is empty.
    handle {
        reverse_proxy agent:3001
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    }

    log {
        output file /data/access.log {
            roll_size 10mb
            roll_keep 5
        }
        format filter {
            wrap json
            fields {
                request>uri query {
                    delete token
                }
            }
        }
    }
}
