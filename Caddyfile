# Desk Agent — public routing.
#
# Two hosts:
#   {$CONSOLE_DOMAIN}  the Open Connector console (whole origin -> connector). The SPA
#                      uses absolute paths (/assets, /api/runs, /api/auth/session, ...)
#                      and a BrowserRouter without basename, so it must own its host.
#                      OC's own admin-token login gates it (token shown once in the wizard).
#   {$DOMAIN}          the agent UI/API. Only the OAuth callback is proxied to the
#                      connector; every other connector endpoint stays internal.
{$CONSOLE_DOMAIN:console.localhost} {
    reverse_proxy connector:3000
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000"
    }
}

{$DOMAIN:localhost} {
    # OAuth redirect target (CONNECTOR_ORIGIN/oauth/callback) — must be public.
    handle /oauth/* {
        reverse_proxy connector:3000
    }

    # Everything else is the agent (wizard, settings, /api/*, /auth, /health).
    handle {
        reverse_proxy agent:3001
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000"
    }

    # Logging with token query parameter filtered out
    log {
        output file /data/access.log {
            roll_size 10mb
            roll_keep 5
        }
        format filter {
            wrap json
            fields {
                request>uri query {
                    delete token
                }
            }
        }
    }
}
