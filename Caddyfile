# Caddy configuration for Desk Agent
# Uses DOMAIN environment variable (passed from docker-compose)
# Defaults to localhost for local development

# Open Connector console on its own subdomain. The console SPA loads assets
# from absolute paths (/assets/...) and shares /api/auth/* paths with the
# agent, so it cannot be served under a sub-path of the main domain.
# Full reverse_proxy is OK here — the console subdomain is NOT public-facing.
{$CONSOLE_DOMAIN:console.localhost} {
    reverse_proxy connector:3000
}

{$DOMAIN:localhost} {
    # OAuth callback from Google and other providers — must reach connector
    # Google redirect_uri is https://{DOMAIN}/oauth/callback
    handle /oauth/callback {
        reverse_proxy connector:3000
    }

    # Catch any leftover OAuth paths that shouldn't hit the agent
    handle /oauth/* {
        reverse_proxy connector:3000
    }

    # Open Connector OAuth API routes — must reach connector BEFORE agent /api/*
    handle /api/oauth/* {
        reverse_proxy connector:3000
    }

    # -------------------------------------------------------------------------
    # SECURITY: All other Open Connector routes are NOT exposed on the public
    # domain. Agent-to-connector traffic uses docker-internal http://connector:3000.
    # The console SPA lives on {$CONSOLE_DOMAIN}. Do not add /v1/*, /mcp,
    # /api/connections, /api/providers, /api/actions, /api/runs, /api/files,
    # /openapi.json, or /docs here.
    # -------------------------------------------------------------------------

    # Agent Web UI and API — all other requests go to the agent
    handle /api/* {
        reverse_proxy agent:3001
    }
    handle /auth {
        reverse_proxy agent:3001
    }
    handle /health {
        reverse_proxy agent:3001
    }
    handle {
        reverse_proxy agent:3001
    }

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000"
    }

    # Logging with token query parameter filtered out
    log {
        output file /data/access.log {
            roll_size 10mb
            roll_keep 5
        }
        format filter {
            wrap json
            fields {
                request>uri query {
                    delete token
                }
            }
        }
    }
}
