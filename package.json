{
  "name": "desk-agent",
  "version": "1.0.0",
  "description": "Personal WhatsApp agent template for one SMB: pair, connect tools, one gated stack per customer.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "start": "node --experimental-strip-types src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "whatsapp",
    "agent",
    "ai",
    "smb",
    "automation",
    "open-connector",
    "pi-coding-agent"
  ],
  "author": "Yishai Kaminsky",
  "license": "MIT",
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@whiskeysockets/baileys": "^6.7.16",
    "better-sqlite3": "^11.7.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode-terminal": "^0.12.0",
    "typebox": "^1.3.7",
    "undici": "^7.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "oxlint": "^0.15.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
