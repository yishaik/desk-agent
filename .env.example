# Desk Agent Configuration
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# ===========================================
# REQUIRED: Security tokens
# ===========================================

# Token for accessing the Web UI (generate a random string)
# This is shown when first running the agent if not set
# Example: openssl rand -hex 32
PAIR_TOKEN=

# Token for Open Connector runtime API.
# Generate a random one — docker-compose passes it to the connector as its
# runtime token, so no console step is needed.
# Example: openssl rand -hex 32
OPEN_CONNECTOR_TOKEN=

# Encryption key for Open Connector credentials storage
# Example: openssl rand -hex 32
CONNECTOR_ENCRYPTION_KEY=

# ===========================================
# REQUIRED: Domain and HTTPS
# ===========================================

# Your domain for HTTPS (Caddy auto-certificates)
DOMAIN=
# Host for the Open Connector console (its own subdomain; needs its own DNS A record).
# Defaults: Caddy serves console.localhost, the agent links to https://console.$DOMAIN.
CONSOLE_DOMAIN=
CONSOLE_URL=

# Public URL for Open Connector OAuth callbacks
# IMPORTANT: In production, set CONNECTOR_ORIGIN=https://{DOMAIN}
# Google OAuth redirect_uri will be: https://{DOMAIN}/oauth/callback
# Caddy routes /oauth/* to the connector internally.
#
# Local development:   CONNECTOR_ORIGIN=http://localhost:3000
# Production:          CONNECTOR_ORIGIN=https://desk.example.com
CONNECTOR_ORIGIN=http://localhost:3000

# ===========================================
# OPTIONAL: Open Connector Console Admin
# ===========================================

# Admin token for Open Connector console access (optional, extra tools).
# Gmail and Calendar connect directly from Settings — no console needed.
# The console at https://console.{DOMAIN} is for additional integrations
# beyond Gmail/Calendar, such as Notion, Slack, GitHub, etc.
#
# IMPORTANT: This token is for CONSOLE ACCESS ONLY.
# The agent process does NOT use this token — it uses OPEN_CONNECTOR_TOKEN
# (the runtime token) for all routine operations including OAuth flows.
#
# This is NOT part of the customer first-run wizard. Set it in .env
# before deployment ONLY if operators need console access for extra tools.
# The agent container does not receive this token (see docker-compose.yml).
# Example: openssl rand -hex 32
CONNECTOR_ADMIN_TOKEN=

# ===========================================
# OPTIONAL: Action Policies
# ===========================================

# Comma-separated list of allowed actions (default: *)
# Examples: gmail.*, github.get_current_user, notion.*
CONNECTOR_ALLOWED_ACTIONS=*

# Comma-separated list of blocked actions
# Takes precedence over allowed actions
CONNECTOR_BLOCKED_ACTIONS=

# ===========================================
# OPTIONAL: Advanced (Operators/Developers Only)
# ===========================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Node environment
NODE_ENV=production

# -------------------------------------------
# ESCAPE HATCH: Direct API key (operators only)
# -------------------------------------------
# Customers should use browser OAuth in the Web UI Settings.
# This is for operators/developers who need to bypass OAuth
# for testing, debugging, or automated deployments.
#
# MODEL_API_KEY=sk-ant-...
# MODEL_API_URL=https://api.anthropic.com/v1/messages
